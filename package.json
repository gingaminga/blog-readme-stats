{
  "name": "express-boilerplate",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production tsc -p . && tsc-alias",
    "dev": "cross-env NODE_ENV=development nodemon --config nodemon.json",
    "eslint": "eslint './src/**/*.{ts,js,mjs}'",
    "prettier": "prettier --write ./src/**/*.ts",
    "test": "cross-env NODE_ENV=test jest",
    "test:clean": "cross-env NODE_ENV=test jest --clearCache",
    "test:dev": "cross-env NODE_ENV=test jest --watch",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/on-finished": "^2.3.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.2.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-asyncify": "^2.1.2",
    "inversify": "^7.10.8",
    "joi": "^18.0.2",
    "lodash": "^4.17.21",
    "on-finished": "^2.4.1",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.1.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix --cache",
      "prettier --write --cache"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write --cache"
    ]
  }
}
